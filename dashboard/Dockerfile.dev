# Local development only: runs the Vite dev server with hot module reload,
# used by the root docker-compose.yml (source bind-mounted at runtime).
#
# NOT used for staging/production images -- those are built from
# dashboard/Dockerfile (a real `vite build` served by nginx). Running this
# dev-server image in production was itself a bug: it injects Vite's HMR
# client (whose WebSocket can't resolve a port through a reverse proxy --
# "wss://localhost:undefined") and serves some dependencies' worker/module
# chunks as blob-URL <script> elements, which the CSP's script-src (no
# 'unsafe-inline', no blob:) correctly refuses to load. A real `vite build`
# emits none of that: no HMR client, and all worker/module chunks as real
# same-origin hashed files.
FROM node:22-alpine

WORKDIR /app

ARG VITE_SUPABASE_URL=http://localhost:3000
ARG VITE_SUPABASE_ANON_KEY=supabase_key
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL
ENV VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY

COPY package.json package-lock.json* ./

RUN npm install

COPY . .

# Security: run the dev server as the non-root `node` user already present
# in the official node images, rather than root (audit finding H14).
RUN chown -R node:node /app
USER node

EXPOSE 5173

CMD ["npm", "run", "dev", "--", "--host"]
